#!/bin/bash
ROBFWPython=/opt/rfwaio/python3/bin/python3

# Handle arguments from command
if [ $# -eq 0 ] || [ "${1}" = "-h" ] || [ "${1}" = "--help" ]; then
  # robot help
  ${ROBFWPython} -m robot -h
elif [ "${1}" = "-v" ] || [ "${1}" = "--version" ]; then
  # robot framework core version
  ${ROBFWPython} -m robot --version
elif [ "${1}" = "-aio" ] || [ "${1}" = "--version_aio" ]; then
  # robot framework aio version
  ${ROBFWPython} -c "from RobotFramework_TestsuitesManagement.Config.config import get_bundle_version; print(get_bundle_version())"
elif [ -f ${1} ]; then
  # execute robot test file directly
  ${ROBFWPython} -m robot "${@}"
else
  ${ROBFWPython} -m robot "${@}"
fi
