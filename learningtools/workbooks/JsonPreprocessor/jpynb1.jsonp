    ],
    "questions": [
        {
            "id": "q1",
            "title": "Exercise 1: Print the first message",
            "prompt": [
                "Write code that prints the exact text `jpynb1 q1`.",
                "The checker looks at the last non-empty printed line in the cell before `q1.check()` runs."
            ],
            "starter_code": [
                "# TODO: Change the message (expected \"jpynb1 q1\")",
                "print(\"Your message here!\")",
                "",
                "# Uncomment to get a hint",
                "# q1.hint()",
                "",
                "# Uncomment to view solution",
                "# q1.solution()",
                "",
                "# DO NOT REMOVE: Mark this question as completed",
                "q1.check()"
            ],
            "hint": [
                "Replace the placeholder text with the expected output for notebook 1 question 1.",
                "",
                "```python",
                "print(\"jpynb1 q1\")",
                "```"
            ],
            "solution": [
                "A valid solution is:",
                "",
                "```python",
                "print(\"jpynb1 q1\")",
                "```"
            ],
            "success_message": "Great work. You printed the exact string for exercise 1.",
            "failure_message": "The checker did not see the expected message for exercise 1.",
            "tags": ["printing", "strings", "exercise"]
        },
        {
            "id": "q2",
            "title": "Exercise 2: Print the second message",
            "prompt": [
                "Write code that prints the exact text `jpynb1 q2`.",
