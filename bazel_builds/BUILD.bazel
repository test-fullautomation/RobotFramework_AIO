# =============================================================================
# Root BUILD.bazel - Workspace Entry Point
# =============================================================================
#
# IMPORTANT: This file is the root BUILD file for the Bazel workspace.
# The actual build targets are defined in the subdirectories under components/:
#
#   //components/python:python_runtime    - Python interpreter distribution
#   //components/py_modules_set_1:*       - Python module set 1
#   //components/py_modules_set_2:*       - Python module set 2
#   //components/installer:*              - Installer targets (using macros)
#
# To build installers, use:
#   bazel build //components/installer:installer_set_1
#   bazel build //components/installer:installer_set_2
#   bazel build //components/installer:all
#
# =============================================================================

# This package is intentionally empty.
# All build targets are organized in the components/ subdirectory.
# See components/installer/BUILD.bazel for installer targets.

