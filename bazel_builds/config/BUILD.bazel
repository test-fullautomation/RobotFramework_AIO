# =============================================================================
# components/config/BUILD.bazel
# =============================================================================
#
# This package intentionally contains no targets. Its only purpose is to
# exist as a Bazel package (see "makes the workspace root a Bazel package"
# in Bazel_Komponenten_Analyse_Statisch.md for the same reasoning applied to
# a root BUILD.bazel) so that "variant_config.bzl" in this directory can be
# referenced as a proper label ("@config//:variant_config.bzl") from other
# modules such as "installer".
# =============================================================================

# package_context.json is a plain, version-controlled data file (bundle
# metadata such as installer_location/bundle_name/bundle_version - NOT a
# Bazel-generated output) that needs to be staged into the final installer
# tree (see installer/installer_variants.bzl and installer/stage_files.py's
# "package_context.json" mapping case). exports_files() makes it referenceable
# as "@config//:package_context.json" from the "installer" module, exactly
# like "variant_config.bzl" above.
exports_files(["package_context.json"])
