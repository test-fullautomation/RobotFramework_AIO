load("@rules_python//python:defs.bzl", "py_binary")
load(":installer_variants.bzl", "create_all_installers", "create_installer")

# =============================================================================
# Build Tools
# =============================================================================
# These Python tools are used by the installer macros during the build process.
# They are marked as private visibility since they are internal implementation
# details and should not be referenced directly from other packages.

# Python tool that invokes the Inno Setup compiler (ISCC.exe) to create
# the final installer executable from the staged files and ISS template.
py_binary(
    name = "build_installer_tool",
    srcs = ["build_installer.py"],
    main = "build_installer.py",
    visibility = ["//visibility:private"],
)

# Python tool that stages (copies) all component files to a temporary
# directory with the correct directory structure expected by Inno Setup.
# This is necessary because Bazel sandbox paths differ from the final
# installation paths defined in the ISS script.
py_binary(
    name = "stage_files_tool",
    srcs = ["stage_files.py"],
    main = "stage_files.py",
    visibility = ["//visibility:private"],
)

# =============================================================================
# Install-Time Console-Script Reinstall Helper ("Solution 2b")
# =============================================================================
# Plain (non-executed-at-build-time) source file, bundled into every
# installer variant alongside the wheels produced by pip_install_dir/
# pip_install_from_source's "wheels_dir" output (see pip_install.bzl and
# stage_files.py's "py-wheels"/"reinstall_console_scripts.py" mapping).
# Run exactly once, at the END of installation, via installer.iss's [Run]
# section - see reinstall_console_scripts.py's own module docstring for
# the full rationale.
exports_files(["reinstall_console_scripts.py"])

# =============================================================================
# Installer Variants (Generated by Macros)
# =============================================================================
# The create_all_installers() macro reads the INSTALLER_VARIANTS dictionary
# from installer_variants.bzl and generates the following targets:
#
#   - test_framework_tng    -> test_framework_tng_setup.exe (Python + Module Set 1 + full test framework stack)
#   - rf_testsuitesmanagement -> rf_testsuitesmanagement_setup.exe (Python + Module Set 1 + RobotFramework TestsuitesManagement)
#   - installer_set_2       -> install_python_set_2.exe (Python + Module Set 2)
#
# Each installer target also creates a corresponding bundle filegroup
# (e.g., installer_set_1_bundle) that aggregates all component files.
#
# To add new installer variants, edit the INSTALLER_VARIANTS dictionary
# in installer_variants.bzl - no changes to this BUILD file are required.

create_all_installers(
    iscc_path = "@inno_setup//:iscc",
    iss_template = "installer.iss",
    visibility = ["//visibility:public"],
)

