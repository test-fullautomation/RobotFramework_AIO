# ============================================================================
# Windows-specific Bazel configuration
# ============================================================================
#
# This file is automatically imported by .bazelrc on Windows systems.
# It contains startup options and paths that must be set before
# Bazel's platform detection runs.
#
# ============================================================================

# ----------------------------------------------------------------------------
# Startup options (set before platform detection)
# ----------------------------------------------------------------------------
# Use very short paths to avoid Windows MAX_PATH (260 character) limit
# This is critical for avoiding WinError 87 with rules_python venv creation
startup --output_base=C:/b
startup --output_user_root=C:/bazel_user

# ----------------------------------------------------------------------------
# Build cache
# ----------------------------------------------------------------------------
# Disk cache for faster rebuilds
build --disk_cache=C:/bazel_cache
