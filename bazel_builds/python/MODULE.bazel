module(
    name = "python",
    version = "0.1.0",
)

# Bzlmod isolates each module's dependency graph. This module loads from
# "@rules_pkg//pkg:mappings.bzl" in its own BUILD.bazel, so it must declare
# rules_pkg itself, even though the root module ("build") already does.
bazel_dep(name = "rules_pkg", version = "1.0.1")

# This module's own BUILD.bazel declares visibility for its targets using
# labels like "@py_modules_set_1//:__pkg__" and "@py_modules_set_2//:__pkg__".
# Bzlmod resolves "@name" labels using the DECLARING module's own repo
# mapping - so even though these are only used for visibility (not load()),
# this module must still declare bazel_dep for them, otherwise the labels
# don't resolve and the visibility check silently fails for the consumers.
bazel_dep(name = "py_modules_set_1", version = "0.1.0")
bazel_dep(name = "py_modules_set_2", version = "0.1.0")

local_path_override(
    module_name = "py_modules_set_1",
    path = "../py_modules_set_1",
)

local_path_override(
    module_name = "py_modules_set_2",
    path = "../py_modules_set_2",
)

# -----------------------------------------------------------------------------
# Python Portable Distribution
# -----------------------------------------------------------------------------
# Pre-built portable Python distribution for Windows x86_64.
# Source: python-build-standalone project by Astral (creators of uv/ruff)
#
# This repository is only visible within THIS module ("python"). Other
# modules (e.g. py_modules_set_1, py_modules_set_2) cannot reference
# "@python_portable_windows" directly - they must depend on this "python"
# module instead and use the re-exported targets in components/python/BUILD.bazel
# (@python//:python_interpreter, @python//:python_runtime).
#
# Version: CPython 3.13.2
# Platform: Windows x86_64 (MSVC build)
# Build date: 2025-02-05 (python-build-standalone release tag "20250205",
# which bumped CPython 3.13.1 -> 3.13.2 - see
# https://github.com/astral-sh/python-build-standalone/releases/tag/20250205)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "python_portable_windows",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20250205/cpython-3.13.2+20250205-x86_64-pc-windows-msvc-install_only.tar.gz"],
    # PLACEHOLDER: Could not be fetched automatically (the download requires
    # passing through an authenticated corporate proxy, which is not
    # available to the tooling that generated this file). Download the
    # matching ".sha256" file from the release page below and paste its
    # content here before running `bazel build` - http_archive fails fast
    # with a clear checksum-mismatch error if this is wrong, so there is no
    # risk of silently using a tampered download, but the placeholder itself
    # will NOT work as-is:
    # https://github.com/astral-sh/python-build-standalone/releases/download/20250205/cpython-3.13.2+20250205-x86_64-pc-windows-msvc-install_only.tar.gz.sha256
    sha256 = "3cb2a8b723a6de5c8ccf3ee205e4f7a67d7235389b6658efc24b6e3e7ebb5d7a",
    strip_prefix = "python",
    build_file_content = """
# Build file for the portable Python distribution.
# Exposes the runtime files and interpreter as separate filegroups.

# Complete Python runtime (all files)
# Used by: components/python:python_runtime
filegroup(
    name = "runtime",
    srcs = glob(["**"], exclude = ["**/__pycache__/**"]),
    visibility = ["//visibility:public"],
)

# Python interpreter executable only
# Used for: Running Python scripts during the build process
filegroup(
    name = "interpreter",
    srcs = ["python.exe"],
    visibility = ["//visibility:public"],
)
""",
)
