module(
    name = "installer",
    version = "0.1.0",
)

# Bzlmod isolates each module's dependency graph. Even though the root
# module ("build") already declares rules_python, this module ("installer")
# must declare it again, because it directly loads from
# "@rules_python//python:defs.bzl" in its own BUILD.bazel.
bazel_dep(name = "rules_python", version = "1.7.0")

# This module references component targets from "python", "py_modules_set_1",
# and "py_modules_set_2" (see installer_variants.bzl: @python//:python_runtime,
# @py_modules_set_1//:py_modules_set_1, @py_modules_set_2//:py_modules_set_2).
# Bzlmod requires each module to declare its own direct dependencies -
# declaring them in the root module ("build") is NOT sufficient here.
bazel_dep(name = "python", version = "0.1.0")
bazel_dep(name = "py_modules_set_1", version = "0.1.0")
bazel_dep(name = "py_modules_set_2", version = "0.1.0")

# This module's inno_setup.bzl references "@inno_setup//:iscc" (default of
# the iscc_path attribute) - the Inno Setup Compiler provided as a hermetic
# Bazel target instead of a hardcoded path to a manually installed ISCC.exe.
bazel_dep(name = "inno_setup", version = "0.1.0")

# own components
bazel_dep(name = "robotframework_testsuitesmanagement", version = "0.1.0")
bazel_dep(name = "python_genpackagedoc", version = "0.1.0")
bazel_dep(name = "python_extensions_collection", version = "0.1.0")
bazel_dep(name = "python_jsonpreprocessor", version = "0.1.0")
bazel_dep(name = "robotframework_qconnect_base", version = "0.1.0")
bazel_dep(name = "robotframework_extensions_collection", version = "0.1.0")
bazel_dep(name = "robotframework_dbus", version = "0.1.0")
bazel_dep(name = "robotframework_doip", version = "0.1.0")
bazel_dep(name = "robotframework_uds", version = "0.1.0")
bazel_dep(name = "robotframework_qconnect_winapp", version = "0.1.0")
bazel_dep(name = "robotframework_robotlog2rqm", version = "0.1.0")
bazel_dep(name = "robotframework_robotlog2db", version = "0.1.0")

# installer_variants.bzl loads "@config//:variant_config.bzl" to obtain
# BASE_COMPONENTS / INSTALLER_VARIANTS - the central, user-facing installer
# variant configuration now lives in its own module/package
# (components/config) instead of being defined inline here.
bazel_dep(name = "config", version = "0.1.0")

local_path_override(
    module_name = "python",
    path = "../python",
)

local_path_override(
    module_name = "inno_setup",
    path = "../inno_setup",
)

local_path_override(
    module_name = "config",
    path = "../config",
)

local_path_override(
    module_name = "py_modules_set_1",
    path = "../py_modules_set_1",
)

local_path_override(
    module_name = "py_modules_set_2",
    path = "../py_modules_set_2",
)

local_path_override(
    module_name = "robotframework_testsuitesmanagement",
    path = "../robotframework-testsuitesmanagement",
)

local_path_override(
    module_name = "python_genpackagedoc",
    path = "../python-genpackagedoc",
)

local_path_override(
    module_name = "python_extensions_collection",
    path = "../python-extensions-collection",
)

local_path_override(
    module_name = "python_jsonpreprocessor",
    path = "../python-jsonpreprocessor",
)

local_path_override(
    module_name = "robotframework_qconnect_base",
    path = "../robotframework-qconnect-base",
)

local_path_override(
    module_name = "robotframework_extensions_collection",
    path = "../robotframework-extensions-collection",
)

local_path_override(
    module_name = "robotframework_dbus",
    path = "../robotframework-dbus",
)

local_path_override(
    module_name = "robotframework_doip",
    path = "../robotframework-doip",
)

local_path_override(
    module_name = "robotframework_uds",
    path = "../RobotFramework-UDS",
)

local_path_override(
    module_name = "robotframework_qconnect_winapp",
    path = "../robotframework-qconnect-winapp",
)

local_path_override(
    module_name = "robotframework_robotlog2rqm",
    path = "../robotframework-robotlog2rqm",
)

