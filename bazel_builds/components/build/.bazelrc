# Bazel configuration for bits project

# Enable automatic platform detection for command-specific flags
# (build:windows/build:linux/... are expanded automatically based on the
# detected OS). NOTE: This does NOT apply to "startup" options - Bazel does
# not support "startup:windows"/"startup:linux" syntax at all, because the
# startup phase runs before the OS-specific command expansion logic exists.
# Startup options (--output_base, --output_user_root) live in separate,
# platform-specific files (.bazelrc.windows / .bazelrc.linux) which are
# loaded explicitly via --bazelrc=<file> on the command line
# (see build_installer.bat). This keeps the batch script free of any
# hardcoded paths - it only selects which rc file to load.
build --enable_platform_specific_config

# ============================================================================
# Windows-specific configuration
# ============================================================================
build:windows --cxxopt=/std:c++17
build:windows --host_cxxopt=/std:c++17
build:windows --enable_runfiles
build:windows --ui_event_filters=-info,-stderr
build:windows --disk_cache=C:/bazel_cache
test:windows --test_output=all

# ============================================================================
# Linux-specific configuration
# ============================================================================
build:linux --cxxopt=-std=c++17
build:linux --host_cxxopt=-std=c++17
build:linux --disk_cache=/tmp/bazel_cache
test:linux --test_output=all

# Verbose output for debugging
# Uncomment to see more details during build
# build --verbose_failures
# build --sandbox_debug

# ============================================================================
# Proxy configuration (inherited from environment)
# ============================================================================
# Proxy settings are NOT hardcoded here. Instead, they are inherited from
# the environment variables of the process that starts the Bazel server.
#
# Required environment variables (set before calling bazel):
#   HTTPS_PROXY - Proxy for HTTPS connections (e.g., https://proxy:8080)
#   HTTP_PROXY  - Proxy for HTTP connections (e.g., http://proxy:8080)
#   NO_PROXY    - Comma-separated list of hosts to bypass proxy
#
# Example (PowerShell):
#   $env:HTTPS_PROXY = "http://proxy.example.com:8080"
#   $env:HTTP_PROXY = "http://proxy.example.com:8080"
#   $env:NO_PROXY = "localhost,127.0.0.1,.example.com"
#   bazel build //...
#
# Example (Bash):
#   export HTTPS_PROXY="http://proxy.example.com:8080"
#   export HTTP_PROXY="http://proxy.example.com:8080"
#   export NO_PROXY="localhost,127.0.0.1,.example.com"
#   bazel build //...

# Pass proxy environment variables to repository rules (http_archive, etc.)
# Note: Without a value, the variable is inherited from the calling process
common --repo_env=HTTPS_PROXY
common --repo_env=HTTP_PROXY
common --repo_env=NO_PROXY

# Pass proxy environment variables to build actions (pip install, etc.)
# Note: Both uppercase and lowercase variants for compatibility
build --action_env=HTTPS_PROXY
build --action_env=HTTP_PROXY
build --action_env=NO_PROXY
build --action_env=https_proxy
build --action_env=http_proxy
build --action_env=no_proxy

