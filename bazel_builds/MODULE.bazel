# =============================================================================
# MODULE.bazel - Bazel Module Configuration
# =============================================================================
#
# This file defines the external dependencies for the Bazel workspace using
# the Bzlmod dependency management system (Bazel 6.0+).
#
# Structure:
#   1. Bazel module dependencies (bazel_dep)
#   2. External archives (http_archive for non-Bzlmod dependencies)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Bazel Module Dependencies
# -----------------------------------------------------------------------------
# These are dependencies available through the Bazel Central Registry (BCR).
# They are automatically fetched and their transitive dependencies resolved.

# Skylib: Common utility functions for Starlark (e.g., paths, shell, types)
# Used for: Helper functions in custom rules and macros
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Rules PKG: Rules for creating distributable packages (tar, zip, deb, rpm)
# Used for: Bundling components into archives before installer creation
bazel_dep(name = "rules_pkg", version = "1.0.1")

# Rules Python: Official Python rules for Bazel (py_binary, py_library, py_test)
# Used for: Building Python tools like build_installer.py and stage_files.py
bazel_dep(name = "rules_python", version = "1.7.0")

# DISABLED: Aspect Bazel Lib - Additional utility rules
# Reason: Toolchain configuration issues on Windows
# bazel_dep(name = "aspect_bazel_lib", version = "2.9.4")


# -----------------------------------------------------------------------------
# External Archives (Non-Bzlmod Dependencies)
# -----------------------------------------------------------------------------
# These dependencies are not available in the Bazel Central Registry and
# must be fetched directly using repository rules.

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# -----------------------------------------------------------------------------
# Python Portable Distribution
# -----------------------------------------------------------------------------
# Pre-built portable Python distribution for Windows x86_64.
# Source: python-build-standalone project by Astral (creators of uv/ruff)
# 
# This provides a self-contained Python installation that can be bundled
# into installers without requiring Python to be installed on the target system.
#
# The distribution includes:
#   - Python interpreter (python.exe)
#   - Standard library
#   - pip and related tools
#
# Version: CPython 3.12.11
# Platform: Windows x86_64 (MSVC build)
# Build date: 2025-06-12

http_archive(
    name = "python_portable_windows",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20250612/cpython-3.12.11+20250612-x86_64-pc-windows-msvc-install_only.tar.gz"],
    sha256 = "7b93afa91931dbc37b307a81b8680b30193736b5ef29a44ef6452f702c306e7a",
    strip_prefix = "python",
    build_file_content = """
# Build file for the portable Python distribution.
# Exposes the runtime files and interpreter as separate filegroups.

# Complete Python runtime (all files)
# Used by: //components/python:python_runtime
filegroup(
    name = "runtime",
    srcs = glob(["**"], exclude = ["**/__pycache__/**"]),
    visibility = ["//visibility:public"],
)

# Python interpreter executable only
# Used for: Running Python scripts during the build process
filegroup(
    name = "interpreter",
    srcs = ["python.exe"],
    visibility = ["//visibility:public"],
)
""",
)

