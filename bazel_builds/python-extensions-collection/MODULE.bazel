module(
    name = "python_extensions_collection",
    # TODO: Keep in sync with the actual release tag of the GitHub
    # repository pinned below (see "tag" attribute of git_repository).
    version = "0.17.1",
)

# This module installs pip packages using the portable Python distribution
# owned by the "python" module. It depends on "python" to access the
# re-exported interpreter and runtime targets (@python//:python_interpreter,
# @python//:python_runtime), since the underlying "@python_portable_windows"
# repository is private to the "python" module and not visible here.
#
# Bzlmod isolates each module's dependency graph, so this module must declare
# bazel_dep(python) itself even though the root module ("build") already does.

bazel_dep(name = "python", version = "0.1.0")

local_path_override(
    module_name = "python",
    path = "../python",
)

# Shared pip_install.bzl rules (pip_install_dir, pip_install_from_source) -
# see components/pip_utils.
bazel_dep(name = "pip_utils", version = "0.1.0")

local_path_override(
    module_name = "pip_utils",
    path = "../pip_utils",
)

# Shared variant_git_repository.bzl rule (Tag vs. Branch selection) - see
# tools/repo_rules. Used below instead of the plain
# @bazel_tools//tools/build_defs/repo:git.bzl git_repository, so that this
# component supports BOTH a fixed, hermetic release tag (production/
# installer builds) AND a tracked branch HEAD (Daily Build/Test), selected
# at build time via --repo_env=BUILD_VARIANT=tagged|daily. See
# documentation/docs/Bazel_Git_Repository_Tag_vs_Branch.md for the full
# rationale.
bazel_dep(name = "repo_rules", version = "0.1.0")

local_path_override(
    module_name = "repo_rules",
    path = "../tools/repo_rules",
)

# =============================================================================
# GitHub Source (instead of PyPI)
# =============================================================================
#
# PythonExtensionsCollection is now built directly from its GitHub
# repository instead of being installed from the published PyPI package.
# This mirrors the pattern established for internal (Bosch-hosted, non-PyPI)
# components such as robotframework-qconnect-dlt - just with a public
# GitHub remote instead of an internal Bitbucket server.
#
#   https://github.com/test-fullautomation/python-extensions-collection
#
# variant_git_repository (see tools/repo_rules/variant_git_repository.bzl)
# fetches this source tree at build time. By default (BUILD_VARIANT unset
# or "tagged") it pins to a FIXED tag for reproducibility (same hermeticity
# principle as the sha256 pin used for the VS Code http_archive in
# components/vscode/MODULE.bazel - just via a Git ref instead of a content
# hash, since GitHub doesn't expose per-download checksums for arbitrary
# refs the way a release asset would). When BUILD_VARIANT=daily is passed
# via --repo_env (see .bazelrc's ":daily" config), it instead tracks the
# "daily_branch" branch's current HEAD - intentionally non-hermetic, for
# Daily Build / Daily Test pipelines only. NEVER use the "daily" variant
# for production/installer builds - see
# documentation/docs/Bazel_Git_Repository_Tag_vs_Branch.md.
#
# Requirements on the build machine:
#   - git.exe must be on PATH (variant_git_repository shells out to it)
#   - Network access to github.com - this DOES go through the normal
#     external internet proxy (rb-proxy-de.bosch.com), same as PyPI, so no
#     additional NO_PROXY entry should be needed (unlike the internal
#     Bitbucket case in robotframework-qconnect-dlt).
#   - Authentication: this repository is PRIVATE and requires a GitHub
#     Personal Access Token (PAT). variant_git_repository has NO token/
#     credential attribute of its own - it simply shells out to
#     `git clone`, so authentication must be configured at the Git-
#     client level on the build machine, exactly like the internal
#     Bitbucket case in robotframework-qconnect-dlt/MODULE.bazel. Do NOT
#     embed the token directly in the "remote" URL below (e.g.
#     "https://<token>@github.com/...") - that file is version-controlled
#     and would leak the token into Git history.
#
#     Recommended: Git credential helper via a .netrc / _netrc file
#     (kept OUTSIDE this repository, e.g. %USERPROFILE%\_netrc on the
#     build machine):
#
#         machine github.com
#         login <your-github-username-or-x-access-token>
#         password <your-personal-access-token>
#
#     Alternative: git config --global http.https://github.com/.extraHeader
#     "Authorization: Bearer <token>" (also machine-local, not in this repo).
#
#     Alternative for CI/automation: write the _netrc file from a secret
#     environment variable just before calling `bazel build`, e.g. in
#     build_installer.bat (see also the equivalent note in
#     robotframework-qconnect-dlt/MODULE.bazel for the same pattern applied
#     to an internal Bitbucket server instead of GitHub).
variant_git_repository = use_repo_rule(
    "@repo_rules//:variant_git_repository.bzl",
    "variant_git_repository",
)

variant_git_repository(
    name = "python_extensions_collection_src",
    remote = "https://github.com/test-fullautomation/python-extensions-collection.git",
    # Used when --config=tagged is passed (BUILD_VARIANT=tagged) and no
    # RELEASE_TAG_OVERRIDE is set. Pin to the exact released version
    # corresponding to the previous PyPI pin (0.17.1). Verified to exist as
    # of 2026-09-22 via the repository's tags page
    # (https://github.com/test-fullautomation/python-extensions-collection/tags):
    # tag name is "rel/0.17.1" (NOT "v0.17.1" - this project's tag naming
    # convention is "rel/<version>" for plain releases and
    # "rel/aio/<version>" for "all-in-one" releases).
    #
    # To build against a DIFFERENT tag without editing this file, override
    # it on the command line instead:
    #   bazel build --config=tagged --repo_env=RELEASE_TAG_OVERRIDE=rel/0.17.0 //...
    release_tag = "rel/0.17.1",
    # Used when BUILD_VARIANT=daily (the project default - no --config
    # needed, see build/.bazelrc) - tracks this branch's current HEAD at
    # fetch time. Intentionally non-hermetic; Daily Build/Test only.
    daily_branch = "develop",
    build_file_content = """filegroup(name = "src", srcs = glob(["**"], exclude = [".git/**"]), visibility = ["//visibility:public"])""",
)

